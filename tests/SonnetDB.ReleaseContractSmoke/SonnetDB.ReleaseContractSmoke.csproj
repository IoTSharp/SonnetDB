<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SmokePackageVersion Condition="'$(SmokePackageVersion)' == ''">3.1.0</SmokePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SonnetDB" Version="$(SmokePackageVersion)" />
  </ItemGroup>
</Project>
