<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SonnetDB.Protocol</AssemblyName>
    <RootNamespace>SonnetDB</RootNamespace>
    <PackageId>SonnetDB.Protocol</PackageId>
    <PackageTags>sonnetdb;protocol;frame;binary</PackageTags>
    <Description>SonnetDB 二进制 Frame 信封、操作码和安全二进制基础类型，不依赖数据库引擎。</Description>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="$([System.String]::Copy('$(PackageVersion)').StartsWith('5.')) And '$(PackageVersion)' != '5.0.0' And !$([System.String]::Copy('$(PackageVersion)').StartsWith('5.0.0-'))">5.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
