<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(SonnetDbQuartzProviderVersion)' != ''">net10.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">15.0</LangVersion>
    <Title>SonnetDB Quartz.NET Job Store</Title>
    <Description>适用于 Quartz.NET 4.8 的 SonnetDB 持久化调度存储。</Description>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <!-- Quartz 根据程序集类型名装载作业、ADO.NET Provider 和序列化器。 -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
    <ProjectReference Include="..\SonnetDB.Data\SonnetDB.Data.csproj" Condition="'$(SonnetDbQuartzProviderVersion)' == ''" />
    <PackageReference Include="SonnetDB" Condition="'$(SonnetDbQuartzProviderVersion)' != ''" />
    <EmbeddedResource Include="QuartzSchema.sql" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
