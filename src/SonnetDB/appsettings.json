{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      },
      "FrameH2": {
        "Url": "http://0.0.0.0:5081",
        "Protocols": "Http2"
      }
    }
  },
  "SonnetDBServer": {
    "DataRoot": "./sonnetdb-data",
    "AutoLoadExistingDatabases": true,
    "AllowAnonymousProbes": true,
    "SqlHttpAdmission": {
      "PermitLimit": 4,
      "QueueLimit": 8
    },
    "Kv": {
      "IndexRebuildMaxWalBytes": 268435456,
      "IndexRebuildMaxOverlayEntries": 100000
    },
    "Mqtt": {
      "Enabled": true,
      "Port": 1883,
      "WebSocketPath": "/mqtt",
      "MaxMqSubscriptionsPerClient": 32,
      "Sparkplug": {
        "Enabled": false,
        "Database": "",
        "MaxPayloadBytes": 1048576,
        "HostId": "sonnetdb-primary",
        "PublishHostState": true,
        "AllowCommands": false
      },
      "ExternalClient": {
        "Enabled": false,
        "Host": "127.0.0.1",
        "Port": 1883,
        "UseTls": false,
        "ClientId": "sonnetdb-external-client",
        "ReconnectDelaySeconds": 5,
        "MaxReconnectDelaySeconds": 60,
        "Subscriptions": [
          { "TopicFilter": "db/+/m/+", "Qos": 1 }
        ]
      }
    },
    "Coap": {
      "Enabled": false,
      "Port": 5683,
      "MaxPayloadBytes": 1048576,
      "Dtls": {
        "Enabled": false,
        "Port": 5684,
        "SessionIdleSeconds": 300,
        "PskKeys": {
        }
      }
    },
    "LineProtocolUdp": {
      "Enabled": false,
      "Port": 8089,
      "Database": "",
      "MaxDatagramBytes": 65507,
      "Precision": "ns"
    },
    "Modbus": {
      "Enabled": false,
      "DiscoveryIntervalMilliseconds": 250,
      "RetryBaseDelayMilliseconds": 100,
      "MaxRetryDelayMilliseconds": 2000,
      "ReconnectBaseDelayMilliseconds": 1000,
      "MaxReconnectDelayMilliseconds": 30000
    },
    "SemanticSearch": {
      "Enabled": false,
      "Provider": "siglip2-onnx",
      "Profile": "siglip2-base-patch16-224",
      "TextModelPath": "",
      "VisionModelPath": "",
      "TokenizerModelPath": "",
      "Dimensions": 768,
      "MaxTextTokens": 64,
      "ImageSize": 224,
      "MaxImageBytes": 20971520,
      "TextInputName": "input_ids",
      "TextOutputName": "pooler_output",
      "VisionInputName": "pixel_values",
      "VisionOutputName": "pooler_output",
      "Backend": "auto",
      "FallbackToManaged": true,
      "DefaultTopK": 10,
      "MaxTopK": 100
    },
    "Observability": {
      "Prometheus": {
        "Enabled": false
      },
      "DiagnosticDump": {
        "Enabled": false
      },
      "SlowQueryLog": {
        "Enabled": true,
        "ThresholdMs": 10000,
        "WarningThresholdMs": 30000,
        "CriticalThresholdMs": 60000,
        "Capacity": 256,
        "AggregateCapacity": 1024
      }
    }
  }
}
