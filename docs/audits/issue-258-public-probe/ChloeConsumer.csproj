<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestoreFallbackFolders></RestoreFallbackFolders>
    <RestoreAdditionalProjectFallbackFolders></RestoreAdditionalProjectFallbackFolders>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ChloeProgram.cs.txt" />
    <Compile Include="UuidChecks.cs" />
    <ProjectReference Include="$(ChloeSourceRoot)/src/Chloe.SonnetDB/Chloe.SonnetDB.csproj" />
    <PackageReference Include="SonnetDB" Version="[4.5.0-preview.ef266.5]" />
    <PackageReference Include="SonnetDB.Core" Version="[4.5.0-preview.ef266.5]" />
  </ItemGroup>
</Project>
