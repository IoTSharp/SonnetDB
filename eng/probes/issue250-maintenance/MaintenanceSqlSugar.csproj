<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestoreFallbackFolders></RestoreFallbackFolders>
    <RestoreAdditionalProjectFallbackFolders></RestoreAdditionalProjectFallbackFolders>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SqlSugarProgram.cs.txt" />
    <ProjectReference Condition="'$(SqlSugarRuntimeDirectory)' == ''" Include="$(SqlSugarSourceRoot)/SqlSugar.SonnetDBCore/SqlSugar.SonnetDBCore.csproj" />
    <Reference Condition="'$(SqlSugarRuntimeDirectory)' != ''" Include="$(SqlSugarRuntimeDirectory)/*.dll" Exclude="$(SqlSugarRuntimeDirectory)/MaintenanceSqlSugar.dll" />
  </ItemGroup>
</Project>
