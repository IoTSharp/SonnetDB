<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SonnetDB.Core.Tests</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <CoreBinaryDirectory Condition="'$(CoreBinaryDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\..\src\SonnetDB.Core\bin\Release\net10.0</CoreBinaryDirectory>
    <DefineConstants Condition="'$(Candidate)' == 'true'">$(DefineConstants);CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SonnetDB.Core">
      <HintPath>$(CoreBinaryDirectory)\SonnetDB.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SonnetDB.Protocol">
      <HintPath>$(CoreBinaryDirectory)\SonnetDB.Protocol.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>
</Project>
