<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestoreFallbackFolders></RestoreFallbackFolders>
    <RestoreAdditionalProjectFallbackFolders></RestoreAdditionalProjectFallbackFolders>
    <SonnetPackageVersion Condition="'$(SonnetPackageVersion)' == ''">4.5.0-preview.ef266.5</SonnetPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NativeProgram.cs.txt" />
    <PackageReference Include="SonnetDB" Version="[$(SonnetPackageVersion)]" />
    <PackageReference Include="SonnetDB.Core" Version="[$(SonnetPackageVersion)]" />
  </ItemGroup>
</Project>
