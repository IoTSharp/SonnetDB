<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SonnetDB.EntityFrameworkCore" Version="$(ProviderVersion)" />
  </ItemGroup>
  <Target Name="RequireProviderIdentity" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(ProviderVersion)' == ''" Text="ProviderVersion must identify an exact candidate or public package." />
  </Target>
</Project>
