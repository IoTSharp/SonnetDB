<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="XCodeReplaceProbe.cs.txt" Link="Program.cs" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1013-beta0732" />
    <ProjectReference Include="../../../src/SonnetDB/SonnetDB.csproj" />
    <Reference Include="XCode"><HintPath>$(XCodeBin)/XCode.dll</HintPath></Reference>
    <Reference Include="SonnetDB.Data"><HintPath>../../../src/SonnetDB.Data/bin/Release/net10.0/SonnetDB.Data.dll</HintPath></Reference>
    <Reference Include="SonnetDB.Protocol"><HintPath>../../../src/SonnetDB.Protocol/bin/Release/net10.0/SonnetDB.Protocol.dll</HintPath></Reference>
  </ItemGroup>
</Project>
