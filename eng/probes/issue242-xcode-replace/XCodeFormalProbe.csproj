<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="XCodeFormalProbe.cs.txt" Link="Program.cs" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1013-beta0732" />
    <PackageReference Include="SonnetDB" Version="4.0.0" />
    <Reference Include="XCode"><HintPath>$(XCodeBin)/XCode.dll</HintPath></Reference>
  </ItemGroup>
</Project>
