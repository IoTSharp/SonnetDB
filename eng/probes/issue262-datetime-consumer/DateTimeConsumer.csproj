<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs.txt" />
    <Reference Include="Chloe"><HintPath>$(ChloeBin)/Chloe.dll</HintPath></Reference>
    <Reference Include="Chloe.SonnetDB"><HintPath>$(ChloeBin)/Chloe.SonnetDB.dll</HintPath></Reference>
    <Reference Include="SonnetDB.Core"><HintPath>$(EngineBin)/SonnetDB.Core.dll</HintPath></Reference>
    <Reference Include="SonnetDB.Data"><HintPath>$(EngineBin)/SonnetDB.Data.dll</HintPath></Reference>
    <Reference Include="System.IO.Hashing"><HintPath>$(EngineDependencyBin)/System.IO.Hashing.dll</HintPath></Reference>
    <Reference Include="System.Numerics.Tensors"><HintPath>$(EngineDependencyBin)/System.Numerics.Tensors.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions"><HintPath>$(EngineDependencyBin)/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.VectorData.Abstractions"><HintPath>$(EngineDependencyBin)/Microsoft.Extensions.VectorData.Abstractions.dll</HintPath></Reference>
  </ItemGroup>
</Project>
