<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FormalPackageProbe.cs.txt" Link="Program.cs" />
    <PackageReference Include="SonnetDB" Version="4.0.0" />
    <Reference Include="Chloe"><HintPath>$(ChloeCoreBin)/Chloe.dll</HintPath></Reference>
    <Reference Include="Chloe.SonnetDB"><HintPath>$(ChloeProviderBin)/Chloe.SonnetDB.dll</HintPath></Reference>
  </ItemGroup>
</Project>
